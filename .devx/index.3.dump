/* ─── CSS Reset & Base Styles ─────────────────────────────────────────────── */

@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap");

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: var(--font-sans);
  background: var(--color-bg);
  color: var(--color-text);
  line-height: 1.5;
  min-height: 100vh;
}

/* ─── Default Theme Variables (Default Dark) ──────────────────────────────── */

:root {
  --color-primary: #3b82f6;
  --color-primary-hover: #2563eb;
  --color-bg: #0f172a;
  --color-bg-secondary: #1e293b;
  --color-surface: #1e293b;
  --color-text: #f1f5f9;
  --color-text-secondary: #94a3b8;
  --color-border: #334155;
  --color-accent: #60a5fa;
  --color-success: #22c55e;
  --color-warning: #f59e0b;
  --color-error: #ef4444;
  --color-sidebar-bg: #0f172a;
  --color-sidebar-text: #94a3b8;
  --color-sidebar-hover: #1e293b;
  --color-card-bg: #1e293b;
  --color-input-bg: #0f172a;
  --color-nav-bg: #1e293b;

  /* ─── Typography scale ─────────────────────────────────────────────────── */
  --font-sans: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-mono: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
  --text-xs: 0.75rem;   /* 12px */
  --text-sm: 0.8125rem; /* 13px */
  --text-base: 0.9375rem; /* 15px */
  --text-md: 1rem;      /* 16px */
  --text-lg: 1.125rem;  /* 18px */
  --text-xl: 1.375rem;  /* 22px */
  --text-2xl: 1.75rem;  /* 28px */

  /* ─── Spacing scale ─────────────────────────────────────────────────────── */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;
  --space-10: 40px;

  /* ─── Radius & elevation ────────────────────────────────────────────────── */
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.12);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.18);
  --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.28);
  --ease: cubic-bezier(0.4, 0, 0.2, 1);
}

/* ─── Scrollbar ──────────────────────────────────────────────────────────── */

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: var(--color-border);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--color-text-secondary);
}

/* ─── Focus Styles ───────────────────────────────────────────────────────── */

:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

/* ─── Selection ──────────────────────────────────────────────────────────── */

::selection {
  background: color-mix(in srgb, var(--color-primary) 30%, transparent);
  color: var(--color-text);
}

/* ─── Links ──────────────────────────────────────────────────────────────── */

a {
  color: var(--color-primary);
  text-decoration: none;
}

a:hover {
  color: var(--color-primary-hover);
}

/* ─── Buttons ────────────────────────────────────────────────────────────── */

button {
  font-family: inherit;
}

button:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

/* ─── Inputs ─────────────────────────────────────────────────────────────── */

input, textarea, select {
  font-family: inherit;
}

input::placeholder, textarea::placeholder {
  color: var(--color-text-secondary);
  opacity: 0.6;
}

/* ─── Continue / Limitation Styles ───────────────────────────────────────── */

.xcoder-limitation-banner {
  background: color-mix(in srgb, var(--color-success) 20%, transparent) !important;
  border: 2px solid var(--color-success) !important;
  animation: xcoder-pulse-border 2s ease-in-out infinite;
}

.xcoder-continue-btn {
  background: var(--color-success) !important;
  color: #fff !important;
  font-weight: 700 !important;
  font-size: 13px !important;
  padding: 8px 20px !important;
  border-radius: 6px !important;
  border: none !important;
  cursor: pointer !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  box-shadow: 0 0 12px color-mix(in srgb, var(--color-success) 50%, transparent) !important;
}

.xcoder-continue-btn:hover:not(:disabled) {
  transform: scale(1.05);
  box-shadow: 0 0 20px color-mix(in srgb, var(--color-success) 70%, transparent) !important;
}

.xcoder-continue-btn:disabled {
  background: var(--color-text-secondary) !important;
  cursor: not-allowed !important;
  box-shadow: none !important;
}

@keyframes xcoder-pulse-border {
  0%, 100% {
    border-color: var(--color-success);
  }
  50% {
    border-color: color-mix(in srgb, var(--color-success) 60%, transparent);
  }
}

/* ─── Toast Notification ─────────────────────────────────────────────────── */

.xcoder-toast-container {
  position: fixed;
  top: 16px;
  right: 16px;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  gap: 8px;
  pointer-events: none;
}

.xcoder-toast {
  pointer-events: auto;
  padding: 12px 20px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 600;
  color: #fff;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  animation: xcoder-toast-slide-in 0.3s ease-out;
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
}

.xcoder-toast-success {
  background: var(--color-success);
}

.xcoder-toast-warning {
  background: var(--color-warning);
}

.xcoder-toast-error {
  background: var(--color-error);
}

@keyframes xcoder-toast-slide-in {
  from {
    transform: translateX(100%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

/* ─── Loading Spinner ────────────────────────────────────────────────────── */

.xcoder-spinner {
  display: inline-block;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2px solid var(--color-border);
  border-top-color: var(--color-primary);
  animation: xcoder-spin 0.7s linear infinite;
}

@keyframes xcoder-spin {
  to {
    transform: rotate(360deg);
  }
}

/* ─── Responsive Navbar ──────────────────────────────────────────────────── */

.xcoder-nav-toggle {
  display: none;
}

@media (max-width: 860px) {
  .xcoder-nav-links,
  .xcoder-nav-user {
    display: none !important;
  }

  .xcoder-nav-toggle {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
  }
}

/* ─── Responsive Content Padding ─────────────────────────────────────────── */

@media (max-width: 520px) {
  .xcoder-main {
    padding: 16px !important;
  }
}

/* ─── Reusable primitives (see ui/src/components/ui/*) ───────────────────── */

.xcoder-card {
  background: var(--color-card-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  transition: border-color 0.15s var(--ease), transform 0.15s var(--ease), box-shadow 0.15s var(--ease);
}

.xcoder-card--interactive {
  cursor: pointer;
}

.xcoder-card--interactive:hover {
  border-color: var(--color-primary);
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.xcoder-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  font-family: inherit;
  font-weight: 600;
  font-size: var(--text-sm);
  border-radius: var(--radius-sm);
  border: 1px solid transparent;
  cursor: pointer;
  transition: background 0.15s var(--ease), border-color 0.15s var(--ease), color 0.15s var(--ease), transform 0.1s var(--ease);
  padding: 9px 16px;
  line-height: 1.2;
}

.xcoder-btn:active {
  transform: translateY(1px);
}

.xcoder-btn:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none;
}

.xcoder-btn--primary {
  background: var(--color-primary);
  color: #fff;
}

.xcoder-btn--primary:hover:not(:disabled) {
  background: var(--color-primary-hover);
}

.xcoder-btn--secondary {
  background: transparent;
  border-color: var(--color-border);
  color: var(--color-text);
}

.xcoder-btn--secondary:hover:not(:disabled) {
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.xcoder-btn--danger {
  background: transparent;
  border-color: var(--color-border);
  color: var(--color-text-secondary);
}

.xcoder-btn--danger:hover:not(:disabled) {
  border-color: var(--color-error);
  color: var(--color-error);
}

.xcoder-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--text-xs);
  font-weight: 600;
  padding: 3px 9px;
  border-radius: 999px;
  border: 1px solid var(--color-border);
  color: var(--color-text-secondary);
  background: color-mix(in srgb, var(--color-text-secondary) 10%, transparent);
}

.xcoder-badge--success {
  color: var(--color-success);
  border-color: color-mix(in srgb, var(--color-success) 45%, transparent);
  background: color-mix(in srgb, var(--color-success) 12%, transparent);
}

.xcoder-badge--warning {
  color: var(--color-warning);
  border-color: color-mix(in srgb, var(--color-warning) 45%, transparent);
  background: color-mix(in srgb, var(--color-warning) 12%, transparent);
}

.xcoder-badge--error {
  color: var(--color-error);
  border-color: color-mix(in srgb, var(--color-error) 45%, transparent);
  background: color-mix(in srgb, var(--color-error) 12%, transparent);
}

.xcoder-badge--primary {
  color: var(--color-primary);
  border-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
  background: color-mix(in srgb, var(--color-primary) 12%, transparent);
}

/* ─── Navbar responsive behavior ─────────────────────────────────────────── */

.xcoder-nav-toggle {
  display: none;
}

@media (max-width: 860px) {
  .xcoder-nav-links,
  .xcoder-nav-user {
    display: none !important;
  }

  .xcoder-nav-toggle {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
  }
}

/* ─── Motion & Accessibility ─────────────────────────────────────────────── */

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}



