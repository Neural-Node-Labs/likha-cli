
================================================================================
FILE: .dockerignore
================================================================================
# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Build output ────────────────────────────────────────────────────────────
dist

# ─── Version control ─────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.gitmodules

# ─── Runtime / generated data ────────────────────────────────────────────────
.log
.agent/index
.agent/index.json
tasks
reports
coverage
*.dump
*.log

# ─── Secrets (never ship into an image) ──────────────────────────────────────
.env
.env.local
.env.production
.env.staging

# ─── OS artifacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ─── IDE ─────────────────────────────────────────────────────────────────────
.vscode
.idea
*.iml

# ─── Separate frontend project (built independently, served via nginx) ──────
ui/node_modules
ui/dist
ui/.env

# ─── Test suites (not needed in production image) ────────────────────────────
e2e/
ui-test-suited/
tests/

# ─── Enhancement / planning docs ─────────────────────────────────────────────
enhancement/

# ─── Documentation (not needed at runtime) ───────────────────────────────────
docs/
*.md
README*
LICENSE

# ─── Scripts (not needed at runtime) ─────────────────────────────────────────
scripts/

# ─── Migration SQL files (embedded in code, not needed as separate files) ────
migrations/

# ─── Tarball artifacts ───────────────────────────────────────────────────────
*.tar.gz
*.tgz

# ─── Docker files (not needed inside the build context) ──────────────────────
docker-compose.yml
docker-compose*.yml
Dockerfile
ui/Dockerfile
ui/nginx.conf


================================================================================
FILE: .env.example
================================================================================
# xcoder environment configuration
# Default LLM provider is DeepSeek (see agent/config/llm.yaml)

DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional fallback provider, used only if DeepSeek is unreachable / unset
ANTHROPIC_API_KEY=

# Used by github_tool for HTTPS auth on clone/fetch/pull/push (fine-grained PAT recommended,
# repo scope). Passed as an in-memory auth header only — never written to git config/disk.
GITHUB_TOKEN=

# API server authentication. If set, all /api/v1/* endpoints require
# Authorization: Bearer <XCODER_API_KEY>. If unset, the API runs without
# authentication (a warning is logged at startup).
XCODER_API_KEY=

# ReAct loop iteration ceiling per round (default: 10). Increase for complex
# multi-step tasks that need more tool-calling turns before completion.
# MAX_ITERATIONS=25

# Opt-in safety rail: when true, read_tool/write_edit_tool refuse any path that resolves
# outside the task's working directory (absolute paths and "../" escapes alike). Off by
# default so existing workflows that intentionally touch files outside the project keep
# working unchanged. Note: run_command_tool is unrestricted shell access regardless of this
# setting, so this is defense-in-depth, not a full sandbox.
# XCODER_RESTRICT_TO_WORKSPACE=true

# ─── Database Configuration ────────────────────────────────────────────────
# Database backend: "sqlite" (default, zero-config) or "postgres"
# DATABASE_TYPE=sqlite

# SQLite: path to the database file (default: ~/.xcoder/data/xcoder.db)
# DATABASE_SQLITE_PATH=

# PostgreSQL: connection string (overrides individual params below)
# DATABASE_URL=postgresql://user:pass@localhost:5432/xcoder

# PostgreSQL individual connection parameters (used when DATABASE_URL is not set)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=xcoder
# DATABASE_USER=xcoder
# DATABASE_PASSWORD=xcoder_pass
# DATABASE_SSL=false

# PostgreSQL pool settings
# DATABASE_POOL_MAX=5
# DATABASE_POOL_IDLE=30000
# DATABASE_POOL_TIMEOUT=5000



================================================================================
FILE: .env.production.example
================================================================================
# =============================================================================
# xcoder — Production Environment Configuration
#
# Copy this file to .env on the production server and fill in real values.
# Never commit real secrets to version control.
#
#   cp .env.production.example .env
#   # Then edit .env with real values
# =============================================================================

# ─── LLM Provider (Required) ────────────────────────────────────────────────
# At least one API key is required. DeepSeek is the primary provider.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional fallback provider, used only if DeepSeek is unreachable
ANTHROPIC_API_KEY=

# ─── GitHub Token (Required for github_tool) ────────────────────────────────
# Fine-grained PAT with repo scope. Used for HTTPS auth on clone/fetch/pull/push.
GITHUB_TOKEN=your_github_token_here

# ─── API Server Authentication (Recommended) ────────────────────────────────
# If set, all /api/v1/* endpoints require Authorization: Bearer <XCODER_API_KEY>.
# If unset, the API runs without authentication (a warning is logged at startup).
XCODER_API_KEY=your_api_key_here

# ─── Database Configuration ─────────────────────────────────────────────────
# Database backend: "sqlite" (default, zero-config) or "postgres"
DATABASE_TYPE=sqlite

# SQLite: path to the database file (default: /data/xcoder.db)
# DATABASE_SQLITE_PATH=/data/xcoder.db

# PostgreSQL: connection string (overrides individual params below)
# DATABASE_URL=postgresql://user:pass@localhost:5432/xcoder

# PostgreSQL individual connection parameters
# DATABASE_HOST=postgres
# DATABASE_PORT=5432
# DATABASE_NAME=xcoder
# DATABASE_USER=xcoder
# DATABASE_PASSWORD=xcoder_pass
# DATABASE_SSL=true

# ─── Server Configuration ───────────────────────────────────────────────────
NODE_ENV=production
XCODER_API_PORT=3001

# ─── ReAct Loop Configuration ───────────────────────────────────────────────
# Maximum iterations per task round (default: 10)
# MAX_ITERATIONS=25

# ─── Logging ────────────────────────────────────────────────────────────────
# LOG_LEVEL=info


================================================================================
FILE: .env.staging.example
================================================================================
# =============================================================================
# xcoder — Staging Environment Configuration
#
# Copy this file to .env on the staging server and fill in real values.
# Never commit real secrets to version control.
#
#   cp .env.staging.example .env
#   # Then edit .env with real values
# =============================================================================

# ─── LLM Provider (Required) ────────────────────────────────────────────────
# Staging can use a test API key or the same key as production.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional fallback provider
ANTHROPIC_API_KEY=

# ─── GitHub Token (Required for github_tool) ────────────────────────────────
GITHUB_TOKEN=your_github_token_here

# ─── API Server Authentication (Recommended) ────────────────────────────────
XCODER_API_KEY=your_staging_api_key_here

# ─── Database Configuration ─────────────────────────────────────────────────
# Staging typically uses SQLite for simplicity
DATABASE_TYPE=sqlite
# DATABASE_SQLITE_PATH=/data/xcoder.db

# ─── Server Configuration ───────────────────────────────────────────────────
NODE_ENV=staging
XCODER_API_PORT=3001

# ─── ReAct Loop Configuration ───────────────────────────────────────────────
# Staging can have higher limits for testing
# MAX_ITERATIONS=50

# ─── Logging ────────────────────────────────────────────────────────────────
# LOG_LEVEL=debug


================================================================================
FILE: .github/workflows/ci.yml
================================================================================
# =============================================================================
# xcoder — CI/CD Pipeline
#
# Triggers:
#   - push / pull_request on main branch
#   - any branch push (for early feedback)
#
# Stages:
#   1. Lint & Type Check (core + UI)
#   2. Unit Tests (vitest)
#   3. Build Standalone Package
#   4. Build Docker Image
#   5. Smoke Test — Standalone
#   6. Smoke Test — Docker
#   7. Push Docker Images to Registry (GHCR)
#   8. Deploy to Staging (main branch only)
#   9. Deploy to Production (tagged releases only, manual approval)
# =============================================================================

name: CI/CD

on:
  push:
    branches: ["**"]
  pull_request:
    branches: [main]
  release:
    types: [published]

env:
  NODE_VERSION: "20"
  DOCKER_IMAGE_NAME: xcoder-api
  UI_DOCKER_IMAGE_NAME: xcoder-ui
  REGISTRY: ghcr.io
  REGISTRY_IMAGE: ghcr.io/${{ github.repository_owner }}/xcoder
  REGISTRY_UI_IMAGE: ghcr.io/${{ github.repository_owner }}/xcoder-ui

jobs:
  # ─── Job 1: Lint, Type Check & Unit Tests ───────────────────────────────
  test:
    name: Lint, Type Check & Unit Tests
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js ${{ env.NODE_VERSION }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: "npm"
          cache-dependency-path: package-lock.json

      - name: Install core dependencies
        run: npm ci

      - name: TypeScript type check (core)
        run: npx tsc --noEmit

      - name: Run unit tests
        run: npm test
        env:
          DATABASE_TYPE: sqlite

      - name: Install UI dependencies
        working-directory: ./ui
        run: npm ci

      - name: TypeScript type check (UI)
        working-directory: ./ui
        run: npx tsc --noEmit

      - name: Build UI
        working-directory: ./ui
        run: npm run build

  # ─── Job 2: Build Standalone Package ────────────────────────────────────
  build-standalone:
    name: Build Standalone Package
    runs-on: ubuntu-latest
    timeout-minutes: 15
    needs: [test]

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js ${{ env.NODE_VERSION }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: "npm"
          cache-dependency-path: package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Build TypeScript
        run: npm run build

      - name: Build standalone package
        run: bash scripts/build.sh --standalone

      - name: Smoke test — standalone package
        run: bash scripts/smoke-test-standalone.sh

      - name: Upload standalone artifact
        uses: actions/upload-artifact@v4
        with:
          name: xcoder-standalone
          path: xcoder-standalone.tar.gz
          retention-days: 30

  # ─── Job 3: Build Docker Image ──────────────────────────────────────────
  build-docker:
    name: Build Docker Image
    runs-on: ubuntu-latest
    timeout-minutes: 20
    needs: [test]

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build Docker image (API)
        uses: docker/build-push-action@v6
        with:
          context: .
          file: Dockerfile
          load: true
          tags: ${{ env.DOCKER_IMAGE_NAME }}:ci-${{ github.sha }},${{ env.DOCKER_IMAGE_NAME }}:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max
          build-args: |
            VERSION=ci-${{ github.sha }}
            BUILD_DATE=${{ github.event.repository.updated_at }}

      - name: Build Docker image (UI)
        uses: docker/build-push-action@v6
        with:
          context: ./ui
          file: ui/Dockerfile
          load: true
          tags: ${{ env.UI_DOCKER_IMAGE_NAME }}:ci-${{ github.sha }},${{ env.UI_DOCKER_IMAGE_NAME }}:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max
          build-args: |
            VERSION=ci-${{ github.sha }}
            BUILD_DATE=${{ github.event.repository.updated_at }}

      - name: Smoke test — Docker
        run: bash scripts/smoke-test-docker.sh
        env:
          DOCKER_API_IMAGE: ${{ env.DOCKER_IMAGE_NAME }}:ci-${{ github.sha }}
          DOCKER_UI_IMAGE: ${{ env.UI_DOCKER_IMAGE_NAME }}:ci-${{ github.sha }}

      - name: Save Docker images as artifact
        run: |
          docker save ${{ env.DOCKER_IMAGE_NAME }}:ci-${{ github.sha }} | gzip > xcoder-api.tar.gz
          docker save ${{ env.UI_DOCKER_IMAGE_NAME }}:ci-${{ github.sha }} | gzip > xcoder-ui.tar.gz

      - name: Upload Docker image artifacts
        uses: actions/upload-artifact@v4
        with:
          name: docker-images
          path: |
            xcoder-api.tar.gz
            xcoder-ui.tar.gz
          retention-days: 30

  # ─── Job 4: Push Docker Images to Registry (GHCR) ───────────────────────
  push-registry:
    name: Push Docker Images to GHCR
    runs-on: ubuntu-latest
    timeout-minutes: 15
    needs: [build-docker, build-standalone]
    # Only push to registry on main branch or tagged releases
    if: github.ref == 'refs/heads/main' || startsWith(github.ref, 'refs/tags/v')

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Log in to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      # ── Determine tags ──────────────────────────────────────────────────
      - name: Generate Docker metadata (API)
        id: meta-api
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY_IMAGE }}
          tags: |
            type=ref,event=branch
            type=ref,event=pr
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=sha,prefix=sha-,format=short
            type=raw,value=latest,enable=${{ github.ref == 'refs/heads/main' }}

      - name: Generate Docker metadata (UI)
        id: meta-ui
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY_UI_IMAGE }}
          tags: |
            type=ref,event=branch
            type=ref,event=pr
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=sha,prefix=sha-,format=short
            type=raw,value=latest,enable=${{ github.ref == 'refs/heads/main' }}

      # ── Build and push API image ────────────────────────────────────────
      - name: Build and push API image
        uses: docker/build-push-action@v6
        with:
          context: .
          file: Dockerfile
          push: true
          tags: ${{ steps.meta-api.outputs.tags }}
          labels: ${{ steps.meta-api.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          build-args: |
            VERSION=${{ github.sha }}
            BUILD_DATE=${{ github.event.repository.updated_at }}

      # ── Build and push UI image ─────────────────────────────────────────
      - name: Build and push UI image
        uses: docker/build-push-action@v6
        with:
          context: ./ui
          file: ui/Dockerfile
          push: true
          tags: ${{ steps.meta-ui.outputs.tags }}
          labels: ${{ steps.meta-ui.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          build-args: |
            VERSION=${{ github.sha }}
            BUILD_DATE=${{ github.event.repository.updated_at }}

  # ─── Job 5: Deploy to Staging ───────────────────────────────────────────
  deploy-staging:
    name: Deploy to Staging
    runs-on: ubuntu-latest
    timeout-minutes: 15
    needs: [push-registry]
    if: github.ref == 'refs/heads/main'

    environment:
      name: staging
      url: https://staging.xcoder.example.com

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Deploy to staging via SSH
        uses: appleboy/ssh-action@v1.2.0
        with:
          host: ${{ secrets.STAGING_HOST }}
          username: ${{ secrets.STAGING_SSH_USER }}
          key: ${{ secrets.STAGING_SSH_KEY }}
          port: ${{ secrets.STAGING_SSH_PORT || '22' }}
          script: |
            set -e
            cd ${{ secrets.STAGING_REMOTE_PATH || '/opt/xcoder' }}

            # Pull latest images from registry
            docker compose pull

            # Recreate containers with new images
            docker compose up -d --force-recreate

            # Wait for health check
            echo "Waiting for services to become healthy..."
            sleep 10
            docker compose ps

            # Quick health check
            curl -sf --connect-timeout 5 --max-time 10 http://localhost:3001/api/v1/health || echo "WARNING: API health check failed"

      - name: Health check — staging
        run: |
          echo "Staging deploy triggered. Health check URL: https://staging.xcoder.example.com"
          # In a real setup, this would curl the staging endpoint

  # ─── Job 6: Deploy to Production (manual approval) ──────────────────────
  deploy-production:
    name: Deploy to Production
    runs-on: ubuntu-latest
    timeout-minutes: 20
    needs: [deploy-staging]
    if: startsWith(github.ref, 'refs/tags/v')

    environment:
      name: production
      url: https://xcoder.example.com

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Deploy to production via SSH
        uses: appleboy/ssh-action@v1.2.0
        with:
          host: ${{ secrets.PROD_HOST }}
          username: ${{ secrets.PROD_SSH_USER }}
          key: ${{ secrets.PROD_SSH_KEY }}
          port: ${{ secrets.PROD_SSH_PORT || '22' }}
          script: |
            set -e
            cd ${{ secrets.PROD_REMOTE_PATH || '/opt/xcoder' }}

            # Create rollback snapshot before deploying
            echo "Creating rollback snapshot..."
            docker compose ps --format json > .xcoder-rollback-snapshot.json 2>/dev/null || echo '{"snapshot":"none"}' > .xcoder-rollback-snapshot.json
            docker compose images --format json > .xcoder-rollback-images.json 2>/dev/null || true

            # Pull latest images from registry
            docker compose pull

            # Recreate containers with new images
            docker compose up -d --force-recreate

            # Wait for health check
            echo "Waiting for services to become healthy..."
            sleep 15

            # Verify all services are running
            docker compose ps

            # Health check
            HTTP_CODE=$(curl -s -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time 10 http://localhost:3001/api/v1/health 2>/dev/null || echo '000')
            if [ "$HTTP_CODE" != "200" ]; then
              echo "ERROR: Health check failed (HTTP $HTTP_CODE). Rolling back..."
              if [ -f .xcoder-rollback-images.json ]; then
                # Restore previous images
                docker compose down
                docker compose up -d
                echo "Rollback completed."
              fi
              exit 1
            fi
            echo "Health check passed (HTTP $HTTP_CODE)"

      - name: Health check — production
        run: |
          echo "Production deploy triggered. Health check URL: https://xcoder.example.com"
          # In a real setup, this would curl the production endpoint


================================================================================
FILE: .github/workflows/npm-publish-github-packages.yml
================================================================================
# This workflow publishes the xcoder npm package to GitHub Packages
# when a release is created. The CI/CD pipeline (ci.yml) handles Docker
# image pushes and deployments — this is for npm package consumers only.
#
# For more information see: https://docs.github.com/en/actions/publishing-packages/publishing-nodejs-packages

name: Publish npm Package

on:
  release:
    types: [created]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - run: npm ci
      - run: npm test

  publish-gpr:
    needs: build
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          registry-url: https://npm.pkg.github.com/
      - run: npm ci
      - run: npm publish
        env:
          NODE_AUTH_TOKEN: ${{secrets.GITHUB_TOKEN}}


================================================================================
FILE: agent/config/llm.yaml
================================================================================
# xcoder/agent/config/llm.yaml
# LLM backend configuration for the xcoder agent.
# Swappable provider — this sets DeepSeek as the active backend.
#
# NOTE: deepseek-chat / deepseek-reasoner are deprecated 2026-07-24 15:59 UTC and will
# return errors after that with no fallback. Using the current model IDs directly:
#   deepseek-v4-flash = non-thinking mode (fast, cheap, default)
#   deepseek-v4-pro   = thinking mode (deeper reasoning, higher cost)
#
# IMPORTANT (per DeepSeek's own Thinking Mode docs): temperature/top_p/presence_penalty/
# frequency_penalty have NO EFFECT in thinking mode -- xcoder's DeepSeekClient omits them
# from the request entirely when thinking is enabled, rather than sending dead parameters.
# reasoning_effort ("high"/"max") is the real lever for thinking-mode depth instead.
#
# max_tokens: DeepSeek's official V4 model table gives BOTH deepseek-v4-pro and
# deepseek-v4-flash a 1,000,000-token total context window and a 384,000-token maximum
# output -- identical for both tiers, only speed/cost/parameter count differ. The old value
# here (4096) was sized for the retired deepseek-chat/deepseek-reasoner models (4K default,
# 8K max), not V4 -- 94x smaller than what V4 actually supports. That mismatch is the
# confirmed root cause of PM-2026-07-25-001 (silent write_edit_tool truncation at ~16.8KB,
# which is exactly 4096 tokens' worth of output).
#
# Sized at 16384 rather than the model's full 384000 ceiling because max_tokens is NOT free
# even when unused: DeepSeek rejects a request outright if prompt_tokens + max_tokens exceeds
# the 1M-token window (see the exact error this incident produced: "1,601,686 in the messages,
# 4,096 in the completion" -- both counted together against the same ceiling BEFORE generation
# starts). A larger max_tokens directly shrinks how much conversation history fits before
# context compaction (contextCompaction.ts) has to work harder. 16384 tokens is roughly 57KB
# of content at typical code/text tokenization (~3.5 chars/token) -- about 1.9x the size of the
# file that actually got truncated in this incident (~30KB intended), while reserving only
# ~1.6% of the window per request instead of 65536's ~6.25%.
#
# This deliberately does NOT try to fit arbitrarily large files in one completion. The
# postmortem's own corrective action P1 concluded "files >20KB should never be written in a
# single response" -- a moderate max_tokens plus truncationGuard.ts (which catches
# finish_reason:"length" and forces a clean chunked retry instead of a silent partial write)
# enforces exactly that as the actual behavior, rather than either the old silent-truncation
# bug or a maximally generous ceiling that's rarely fully used. If real-world usage regularly
# needs single-call writes larger than ~57KB, raise this value -- but prefer teaching the model
# to write large files as multiple mode='edit' appends over reserving a bigger ceiling that
# costs context budget on every single request regardless of whether that file is being touched.
provider: deepseek
base_url: https://api.deepseek.com/v1
endpoint: /chat/completions
model: deepseek-v4-pro    # non-thinking mode; use deepseek-v4-pro for RCA/Architect/Pentester where deep reasoning matters
api_key_env: DEEPSEEK_API_KEY
max_tokens: 16384
temperature: 0.0            # DeepSeek's own published guidance: 0.0 for code/math tasks (this is a coding agent)
thinking: false              # always sent explicitly (enabled/disabled), never omitted

# Per-skill overrides: some skills benefit from thinking mode + higher reasoning effort even
# if the default stays fast. reasoning_effort only takes effect when thinking is true.
overrides:
  rca:
    model: deepseek-v4-pro
    thinking: true
    reasoning_effort: high
  architect:
    model: deepseek-v4-pro
    thinking: true
    reasoning_effort: high
  pentester:
    model: deepseek-v4-pro
    thinking: true
    reasoning_effort: max    # security-critical reasoning gets the deepest effort level

# Fallback provider if DEEPSEEK_API_KEY is unset or the API errors out.
fallback:
  provider: deepseek
  base_url: https://api.deepseek.com/v1
  model: deepseek-v4-flash
  api_key_env: DEEPSEEK_API_KEY


================================================================================
FILE: deploy_remote.py
================================================================================
#!/usr/bin/env python3
"""
Deploy devnull stack to remote Docker host via SSH using paramiko.

Usage:
    python deploy_remote.py [--host HOST] [--port PORT] [--path REMOTE_PATH]
                           [--user USER] [--password PASSWORD]
                           [--skip-validation] [--skip-health] [--skip-rollback]
                           [--pull] [--compose-file FILE] [--env-file FILE]
                           [--rollback]

Environment variables:
    REMOTE_HOST             SSH host (default: 86.38.217.69)
    REMOTE_PORT             SSH port (default: 22)
    REMOTE_PATH             Remote deployment path (default: /opt/devnull)
    REMOTE_SSH_USER         SSH username
    REMOTE_SSH_PASSWORD     SSH password
    REMOTE_SSH_KEY          Path to SSH private key

Features:
    - Pre-deploy validation (Docker version, disk space)
    - Rollback snapshot + restore
    - Health verification after deploy
    - Compose file selection
    - Registry pull mode (skip build)
    - Environment file shipping
    - Idempotent: safe to re-run
"""

import os
import sys
import tarfile
import io
import time
import json
import re
import argparse
import paramiko

# ─── Defaults ────────────────────────────────────────────────────────────────
DEFAULT_HOST = "86.38.217.69"
DEFAULT_PORT = 22
DEFAULT_REMOTE_PATH = "/opt/devnull"

# ─── Parse arguments ─────────────────────────────────────────────────────────
def parse_args():
    parser = argparse.ArgumentParser(
        description="Deploy devnull stack to remote Docker host via SSH",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Environment variables:
    REMOTE_HOST             SSH host (default: 86.38.217.69)
    REMOTE_PORT             SSH port (default: 22)
    REMOTE_PATH             Remote deployment path (default: /opt/devnull)
    REMOTE_SSH_USER         SSH username
    REMOTE_SSH_PASSWORD     SSH password
    REMOTE_SSH_KEY          Path to SSH private key
        """
    )
    parser.add_argument("--host", help=f"SSH host (default: {DEFAULT_HOST}, env: REMOTE_HOST)")
    parser.add_argument("--port", type=int, help=f"SSH port (default: {DEFAULT_PORT}, env: REMOTE_PORT)")
    parser.add_argument("--path", help=f"Remote path (default: {DEFAULT_REMOTE_PATH}, env: REMOTE_PATH)")
    parser.add_argument("--user", help="SSH username (env: REMOTE_SSH_USER)")
    parser.add_argument("--password", help="SSH password (env: REMOTE_SSH_PASSWORD)")
    parser.add_argument("--key", help="SSH private key path (env: REMOTE_SSH_KEY)")
    parser.add_argument("--skip-validation", action="store_true", help="Skip pre-deploy validation")
    parser.add_argument("--skip-health", action="store_true", help="Skip health check after deploy")
    parser.add_argument("--skip-rollback", action="store_true", help="Skip rollback snapshot")
    parser.add_argument("--pull", action="store_true", help="Pull images from registry instead of building")
    parser.add_argument("--compose-file", help="Specific compose file to use")
    parser.add_argument("--env-file", help="Path to .env file to ship")
    parser.add_argument("--rollback", action="store_true", help="Rollback to previous deployment")
    return parser.parse_args()


def get_config(args):
    """Merge CLI args, env vars, and defaults."""
    return {
        "host": args.host or os.environ.get("REMOTE_HOST") or DEFAULT_HOST,
        "port": args.port or int(os.environ.get("REMOTE_PORT", str(DEFAULT_PORT))),
        "remote_path": args.path or os.environ.get("REMOTE_PATH") or DEFAULT_REMOTE_PATH,
        "user": args.user or os.environ.get("REMOTE_SSH_USER"),
        "password": args.password or os.environ.get("REMOTE_SSH_PASSWORD"),
        "key": args.key or os.environ.get("REMOTE_SSH_KEY"),
        "skip_validation": args.skip_validation,
        "skip_health": args.skip_health,
        "skip_rollback": args.skip_rollback,
        "pull": args.pull,
        "compose_file": args.compose_file,
        "env_file": args.env_file,
        "rollback": args.rollback,
    }


# ─── SSH helpers ─────────────────────────────────────────────────────────────
def exec_command(client, command, timeout=300, use_pty=False):
    """Run a command and return (exit_code, stdout, stderr)."""
    stdin, stdout, stderr = client.exec_command(command, timeout=timeout, get_pty=use_pty)
    exit_code = stdout.channel.recv_exit_status()
    out = stdout.read().decode('utf-8', errors='replace')
    err = stderr.read().decode('utf-8', errors='replace')
    return exit_code, out, err


def create_tar_of_workspace():
    """Create a tar.gz of the workspace (excluding .git, node_modules, etc.)."""
    exclude_dirs = {'.git', 'node_modules', '.agent', 'dist', '__pycache__'}
    exclude_extensions = {'.log', '.agent'}

    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode='w:gz') as tar:
        for root, dirs, files in os.walk('.'):
            # Skip excluded directories
            dirs[:] = [d for d in dirs if d not in exclude_dirs and not d.startswith('.')]

            for f in files:
                filepath = os.path.join(root, f)
                # Skip excluded extensions
                if any(f.endswith(ext) for ext in exclude_extensions):
                    continue
                try:
                    tar.add(filepath, arcname=filepath)
                except Exception as e:
                    print(f"  Warning: could not add {filepath}: {e}")

    buf.seek(0)
    return buf.read()


def clean_output(text, max_len=2000):
    """Clean ANSI escape sequences and truncate."""
    clean = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', text)
    clean = clean.encode('ascii', errors='replace').decode('ascii')
    if len(clean) > max_len:
        clean = clean[:max_len] + "\n... (truncated)"
    return clean


# ─── Deploy steps ────────────────────────────────────────────────────────────

def step_pre_check(client, config):
    """Pre-deploy validation: Docker version, disk space."""
    print("\n[1/8] Pre-deploy validation...")
    if config["skip_validation"]:
        print("  Skipped (--skip-validation)")
        return True

    code, out, err = exec_command(client, "docker --version && docker compose version && df -h / | tail -1")
    if code != 0:
        print(f"  ERROR: Docker not available: {clean_output(err)}")
        return False
    print(f"  {clean_output(out)}")
    return True


def step_create_remote_dir(client, config):
    """Create remote directory."""
    print(f"\n[2/8] Creating remote directory {config['remote_path']}...")
    code, out, err = exec_command(client, f"mkdir -p {config['remote_path']}")
    if code != 0:
        print(f"  ERROR: {clean_output(err)}")
        return False
    print("  Done")
    return True


def step_upload_workspace(client, config):
    """Upload workspace via SFTP."""
    print("\n[3/8] Uploading workspace...")
    tar_data = create_tar_of_workspace()
    print(f"  Workspace tar.gz size: {len(tar_data) / 1024 / 1024:.1f} MB")

    sftp = client.open_sftp()
    remote_tar_path = f"{config['remote_path']}/workspace.tar.gz"
    try:
        with sftp.open(remote_tar_path, 'wb') as f:
            f.write(tar_data)
        print("  Upload complete")
        return True
    except Exception as e:
        print(f"  ERROR: Upload failed: {e}")
        return False
    finally:
        sftp.close()


def step_upload_env_file(client, config):
    """Upload .env file if specified."""
    if not config["env_file"]:
        return True

    print(f"\n[4/8] Uploading env file: {config['env_file']}...")
    if not os.path.exists(config["env_file"]):
        print(f"  WARNING: Env file not found: {config['env_file']}")
        return True

    sftp = client.open_sftp()
    try:
        sftp.put(config["env_file"], f"{config['remote_path']}/.env")
        print("  Env file uploaded")
        return True
    except Exception as e:
        print(f"  WARNING: Env file upload failed: {e}")
        return True
    finally:
        sftp.close()


def step_extract_remote(client, config):
    """Extract workspace on remote."""
    print(f"\n[5/8] Extracting on remote...")
    remote_tar_path = f"{config['remote_path']}/workspace.tar.gz"
    code, out, err = exec_command(
        client,
        f"cd {config['remote_path']} && tar xzf workspace.tar.gz && rm workspace.tar.gz"
    )
    if code != 0:
        print(f"  ERROR: {clean_output(err)}")
        return False
    print("  Extracted successfully")
    return True


def step_rollback_snapshot(client, config):
    """Create rollback snapshot before deploying."""
    if config["skip_rollback"]:
        print("\n[6/8] Rollback snapshot: skipped (--skip-rollback)")
        return True

    print("\n[6/8] Creating rollback snapshot...")
    code, out, err = exec_command(
        client,
        f"cd {config['remote_path']} && "
        f"docker compose ps --format json > .devnull-rollback-snapshot.json 2>/dev/null || "
        f"echo '{{\"snapshot\":\"none\"}}' > .devnull-rollback-snapshot.json && "
        f"docker compose images --format json > .devnull-rollback-images.json 2>/dev/null || true && "
        f"echo 'SNAPSHOT_SAVED'"
    )
    if "SNAPSHOT_SAVED" in out:
        print("  Rollback snapshot saved")
    else:
        print(f"  WARNING: {clean_output(out)}")
    return True


def step_run_docker(client, config):
    """Run docker compose up."""
    print("\n[7/8] Running docker compose...")

    # Build the docker command
    cmd_parts = ["docker compose"]

    if config["compose_file"]:
        cmd_parts.append(f"-f {config['compose_file']}")

    if config["pull"]:
        cmd_parts.append("up -d --pull always")
    else:
        cmd_parts.append("up -d --build")

    docker_cmd = " ".join(cmd_parts)
    print(f"  Command: {docker_cmd}")

    code, out, err = exec_command(
        client,
        f"cd {config['remote_path']} && {docker_cmd} 2>&1",
        timeout=600
    )

    combined = out + err
    if combined:
        print(f"  Output:\n{clean_output(combined, 3000)}")

    if code != 0:
        print(f"  WARNING: docker compose returned exit code {code}")
        return False
    return True


def step_health_check(client, config):
    """Verify services are healthy after deploy."""
    if config["skip_health"]:
        print("\n[8/8] Health check: skipped (--skip-health)")
        return True

    print("\n[8/8] Health check...")
    time.sleep(5)

    # Check container status
    code, out, err = exec_command(client, f"cd {config['remote_path']} && docker compose ps")
    print(f"  Container status:\n{clean_output(out, 1000)}")

    # Check API health
    code, out, err = exec_command(
        client,
        "curl -s -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time 10 "
        "http://localhost:3001/api/v1/health 2>/dev/null || echo 'failed'"
    )
    http_code = out.strip()
    print(f"  API health endpoint: HTTP {http_code}")

    # Check UI health
    code, out, err = exec_command(
        client,
        "curl -s -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time 10 "
        "http://localhost:8080/ 2>/dev/null || echo 'failed'"
    )
    ui_code = out.strip()
    print(f"  UI health endpoint: HTTP {ui_code}")

    return http_code == "200"


def step_rollback(client, config):
    """Rollback to previous deployment."""
    print("\n[ROLLBACK] Rolling back to previous deployment...")

    # Check for rollback snapshot
    code, out, err = exec_command(
        client,
        f"test -f {config['remote_path']}/.devnull-rollback-snapshot.json && echo 'EXISTS' || echo 'NOT_FOUND'"
    )

    if "EXISTS" in out:
        print("  Rollback snapshot found. Restoring...")
        code, out, err = exec_command(
            client,
            f"cd {config['remote_path']} && "
            f"docker compose down 2>/dev/null; "
            f"docker compose up -d 2>&1",
            timeout=300
        )
        print(f"  {clean_output(out + err, 2000)}")

        # Health check after rollback
        time.sleep(10)
        code, out, err = exec_command(
            client,
            "curl -s -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time 10 "
            "http://localhost:3001/api/v1/health 2>/dev/null || echo 'failed'"
        )
        print(f"  API health after rollback: HTTP {out.strip()}")
    else:
        print("  No rollback snapshot found. Attempting restart with cached images...")
        code, out, err = exec_command(
            client,
            f"cd {config['remote_path']} && docker compose down 2>/dev/null; docker compose up -d 2>&1",
            timeout=300
        )
        print(f"  {clean_output(out + err, 2000)}")


# ─── Main ────────────────────────────────────────────────────────────────────
def main():
    args = parse_args()
    config = get_config(args)

    if not config["user"]:
        print("ERROR: SSH user not specified. Use --user or set REMOTE_SSH_USER env var.")
        sys.exit(1)

    if not config["password"] and not config["key"]:
        print("ERROR: SSH password or key not specified.")
        print("  Use --password or set REMOTE_SSH_PASSWORD env var.")
        print("  Use --key or set REMOTE_SSH_KEY env var.")
        sys.exit(1)

    print(f"Connecting to {config['user']}@{config['host']}:{config['port']}...")

    client = paramiko.SSHClient()
    client.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    try:
        # Connect
        connect_kwargs = {
            "hostname": config["host"],
            "port": config["port"],
            "username": config["user"],
            "timeout": 30,
        }
        if config["password"]:
            connect_kwargs["password"] = config["password"]
        if config["key"]:
            connect_kwargs["key_filename"] = config["key"]

        client.connect(**connect_kwargs)
        print("  Connected!")

        # Rollback mode
        if config["rollback"]:
            step_rollback(client, config)
            print("\n[OK] Rollback complete!")
            return

        # Deploy steps
        if not step_pre_check(client, config):
            print("\n[FAIL] Pre-deploy validation failed. Aborting.")
            sys.exit(1)

        if not step_create_remote_dir(client, config):
            print("\n[FAIL] Failed to create remote directory. Aborting.")
            sys.exit(1)

        if not step_upload_workspace(client, config):
            print("\n[FAIL] Failed to upload workspace. Aborting.")
            sys.exit(1)

        step_upload_env_file(client, config)

        if not step_extract_remote(client, config):
            print("\n[FAIL] Failed to extract workspace. Aborting.")
            sys.exit(1)

        step_rollback_snapshot(client, config)

        docker_ok = step_run_docker(client, config)

        health_ok = step_health_check(client, config)

        # If docker command failed or health check failed, attempt rollback
        if not docker_ok or not health_ok:
            print("\n[WARNING] Deploy had issues. Attempting rollback...")
            step_rollback(client, config)
            print("\n[FAIL] Deployment failed. Rollback attempted.")
            sys.exit(1)

        print("\n[OK] Deployment complete!")

    except paramiko.AuthenticationException:
        print("ERROR: Authentication failed. Check REMOTE_SSH_USER and REMOTE_SSH_PASSWORD.")
        sys.exit(1)

    except paramiko.SSHException as e:
        print(f"ERROR: SSH connection failed: {e}")
        sys.exit(1)

    except Exception as e:
        print(f"ERROR: Unexpected error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()


