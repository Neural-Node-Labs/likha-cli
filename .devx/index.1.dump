{
  "name": "xcoder",
  "version": "0.2.0",
  "description": "xcoder — a ReAct CLI agent with hot-pluggable role skills, DeepSeek by default.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "xcoder": "dist/cli/index.js"
  },
  "scripts": {
    "xcoder:link": "npm link",
    "xcoder:unlink": "npm unlink -g xcoder",
    "xcoder:install": "npm install && npm install --prefix ui",
    "xcoder:build": "npm run build && npm run build --prefix ui",
    "xcoder:ui": "concurrently \"node dist/cli/index.js --serve --port 3001\" \"npm run dev --prefix ui\"",
    "xcoder:api": "node dist/cli/index.js --serve --port 3001",
    "build": "tsc -p tsconfig.json && node -e \"fs.cpSync('agent', 'dist/config/agent', { recursive: true })\"",
    "start": "node dist/cli/index.js",
    "dev": "ts-node --esm src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:build": "node scripts/cross-platform-shell.mjs build -- --compile",
    "package:validate": "node scripts/cross-platform-shell.mjs build -- --validate",
    "package:tarball": "node scripts/cross-platform-shell.mjs build -- --tarball",
    "package:docker": "node scripts/cross-platform-shell.mjs build -- --docker",
    "package:all": "node scripts/cross-platform-shell.mjs build -- --all",
    "setup": "node scripts/cross-platform-shell.mjs setup",
    "setup:non-interactive": "node scripts/cross-platform-shell.mjs setup -- --non-interactive",
    "deploy:install": "node scripts/cross-platform-shell.mjs install",
    "install:docker": "node scripts/cross-platform-shell.mjs install-docker",
    "init-db": "node scripts/cross-platform-shell.mjs init-db"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.8",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "commander": "^12.1.0",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "fast-glob": "^3.3.2",
    "js-yaml": "^4.1.0",
    "multer": "^2.0.0",
    "pg": "^8.13.0",
    "playwright": "^1.61.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
