# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Build output ────────────────────────────────────────────────────────────
dist

# ─── Version control ─────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.gitmodules

# ─── Runtime / generated data ────────────────────────────────────────────────
.log
.agent/index
.agent/index.json
tasks
reports
coverage
*.dump
*.log

# ─── Secrets (never ship into an image) ──────────────────────────────────────
.env
.env.local
.env.production
.env.staging

# ─── OS artifacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ─── IDE ─────────────────────────────────────────────────────────────────────
.vscode
.idea
*.iml

# ─── Separate frontend project (built independently, served via nginx) ──────
ui/node_modules
ui/dist
ui/.env

# ─── Test suites (not needed in production image) ────────────────────────────
e2e/
ui-test-suited/
tests/

# ─── Enhancement / planning docs ─────────────────────────────────────────────
enhancement/

# ─── Documentation (not needed at runtime) ───────────────────────────────────
docs/
*.md
README*
LICENSE

# ─── Scripts (not needed at runtime) ─────────────────────────────────────────
scripts/

# ─── Migration SQL files (embedded in code, not needed as separate files) ────
migrations/

# ─── Tarball artifacts ───────────────────────────────────────────────────────
*.tar.gz
*.tgz

# ─── Docker files (not needed inside the build context) ──────────────────────
docker-compose.yml
docker-compose*.yml
Dockerfile
ui/Dockerfile
ui/nginx.conf

