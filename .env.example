# xcoder environment configuration
# Default LLM provider is DeepSeek (see agent/config/llm.yaml).
# The active provider is set in agent/config/llm.yaml via `provider`; `api_key_env` there
# names the environment variable holding the key, so ANY provider's key belongs here
# (DEEPSEEK_API_KEY is the default, ANTHROPIC_API_KEY is shown as a fallback example).

DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional fallback provider, used only if DeepSeek is unreachable / unset
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Used by github_tool for HTTPS auth on clone/fetch/pull/push (fine-grained PAT recommended,
# repo scope). Passed as an in-memory auth header only — never written to git config/disk.
GITHUB_TOKEN=

# API server authentication. If set, all /api/v1/* endpoints require
# Authorization: Bearer <XCODER_API_KEY>. If unset, the API runs without
# authentication (a warning is logged at startup).
XCODER_API_KEY=

# ReAct loop iteration ceiling per round (default: 10). Increase for complex
# multi-step tasks that need more tool-calling turns before completion.
# MAX_ITERATIONS=25

# Opt-in safety rail: when true, read_tool/write_edit_tool refuse any path that resolves
# outside the task's working directory (absolute paths and "../" escapes alike). Off by
# default so existing workflows that intentionally touch files outside the project keep
# working unchanged. Note: run_command_tool is unrestricted shell access regardless of this
# setting, so this is defense-in-depth, not a full sandbox.
# XCODER_RESTRICT_TO_WORKSPACE=true

# ─── Database Configuration ────────────────────────────────────────────────
# Database backend: "sqlite" (default, zero-config) or "postgres"
# DATABASE_TYPE=sqlite

# SQLite: path to the database file (default: ~/.xcoder/data/xcoder.db)
# DATABASE_SQLITE_PATH=

# PostgreSQL: connection string (overrides individual params below)
# DATABASE_URL=postgresql://user:pass@localhost:5432/xcoder

# PostgreSQL individual connection parameters (used when DATABASE_URL is not set)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=xcoder
# DATABASE_USER=xcoder
# DATABASE_PASSWORD=xcoder_pass
# DATABASE_SSL=false

# PostgreSQL pool settings
# DATABASE_POOL_MAX=5
# DATABASE_POOL_IDLE=30000
# DATABASE_POOL_TIMEOUT=5000


